# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# BingX API Configuration
BINGX_API_KEY=your_api_key_here
BINGX_SECRET_KEY=your_secret_key_here
BINGX_BASE_URL=https://open-api.bingx.com
BINGX_TESTNET=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017/strata-trader
MONGODB_USER=
MONGODB_PASSWORD=

# Trading Configuration
DEFAULT_RISK_PERCENT=1
MAX_LEVERAGE=20
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PERCENT=5

# Market Data
MARKET_UPDATE_INTERVAL=5000
CANDLE_CACHE_TTL=300000

# Levels Calculation
LEVELS_UPDATE_INTERVAL=60000
MIN_LEVEL_STRENGTH=40
MAX_LEVEL_DISTANCE_PERCENT=0.5

# Divergence Detection
DIV_SCAN_INTERVAL=30000
MIN_DIVERGENCE_SCORE=50
REQUIRED_INDICATORS=1

# Backtesting
BACKTEST_DEFAULT_CAPITAL=10000
BACKTEST_COMMISSION_PERCENT=0.075
BACKTEST_SLIPPAGE_PERCENT=0.05

# Security
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRATION=7d

# Logging
LOG_LEVEL=debug

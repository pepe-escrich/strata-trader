# Production Environment Variables for Render
# Copy these to Render Dashboard → Environment

# Application
NODE_ENV=production
PORT=3000
API_PREFIX=api

# BingX API (Get from https://bingx.com/en-us/account/api/)
BINGX_API_KEY=your_production_api_key_here
BINGX_SECRET_KEY=your_production_secret_key_here
BINGX_BASE_URL=https://open-api.bingx.com
BINGX_TESTNET=false  # Set to false for real trading, true for demo

# MongoDB (Optional - Recommended for production)
# Get from https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/strata-trader?retryWrites=true&w=majority

# Trading Configuration
DEFAULT_RISK_PERCENT=1
MAX_LEVERAGE=20
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PERCENT=5

# Market Data
MARKET_UPDATE_INTERVAL=5000
CANDLE_CACHE_TTL=300000

# Levels Calculation
LEVELS_UPDATE_INTERVAL=60000
MIN_LEVEL_STRENGTH=40
MAX_LEVEL_DISTANCE_PERCENT=0.5

# Divergence Detection
DIV_SCAN_INTERVAL=30000
MIN_DIVERGENCE_SCORE=50
REQUIRED_INDICATORS=1

# Backtesting
BACKTEST_DEFAULT_CAPITAL=10000
BACKTEST_COMMISSION_PERCENT=0.075
BACKTEST_SLIPPAGE_PERCENT=0.05
